DATABASE_URL="postgresql://user:password@localhost:5432/plant_nursery_directory?schema=public"

# Prisma needs a non-pooled connection for running migrations. If your
# database has no connection pooler in front of it, this can be identical
# to DATABASE_URL. If you're on Supabase: in your project's Settings ->
# Database page, use the "Transaction" pooler connection string (port
# 6543) for DATABASE_URL, and the "Session" pooler or direct connection
# string (port 5432) for DIRECT_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/plant_nursery_directory?schema=public"

# Secret required to access the /admin moderation page. Generate a long
# random value, e.g. `openssl rand -base64 24`.
ADMIN_SECRET="change-me"

# Optional: only needed to run scripts/import-places.ts, which imports
# real nursery listings from the Google Places API.
GOOGLE_PLACES_API_KEY=""
